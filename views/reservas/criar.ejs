<!DOCTYPE html>
<html lang='en'>
<head>
    <meta charset='utf-8'>
    <meta name='viewport' content='width=device-width, initial-scale=1'>
    <title><%= titulo %></title>
    <link rel='stylesheet' href='/css/style.css'>
</head>
<body>
    <h1> Nova Reserva </h1>
    <a href="/reservas">Voltar</a>
    <hr>

    <% if (erro) { %>
        <p style="color: red;"><%= erro %></p>
    <% } %>

    <form action="/reservas/criar" method="POST">
        <label>Quarto:</label>
        <select name="quartoId" required>
            <% quartos.forEach(quarto => { %>
                <option value="<%= quarto.id %>"><%= quarto.numero %> - <%= quarto.tipo %> (R$ <%= quarto.precoDiaria.toFixed(2) %>/diaria)</option>
            <% }) %>
        </select> <br><br>

        <label>Data de Entrada:</label>
        <input type="date" name="dataEntrada" required> <br><br>

        <label>Data de Saída:</label>
        <input type="date" name="dataSaida" required> <br><br>

        <button type="submit">Criar Reserva</button>
</body>
</html>